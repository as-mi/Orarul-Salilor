# Copiaza in `.env` (care nu intra in git) si completeaza.

# Cheia cu care se semneaza sesiunile. Obligatorie in productie: openssl rand -hex 32
ORAR_SECRET=

# SSO-ul ASMI (Keycloak). Conturile intra doar prin el; adminii sunt cei cu rolul `cddd`.
# Clientul `orarul-salilor-web` il creeaza ../SSO-ASMI/scripts/configure-orarul.sh; secretul
# se ia din Keycloak: Clients -> orarul-salilor-web -> Credentials. Fara ISSUER, SSO-ul e oprit
# si ramane doar adminul de urgenta de mai jos.
ORAR_SSO_ISSUER=https://sso.asmi.ro/realms/asmi-prod
ORAR_SSO_CLIENT_ID=orarul-salilor-web
ORAR_SSO_CLIENT_SECRET=
# Rolul de realm care face pe cineva admin al Orarului (implicit cddd).
# ORAR_SSO_ROL_ADMIN=cddd

# Adminul de urgenta: intra pe /login?admin=1 si ajunge pe /admin. Nu sta in baza de date
# si merge si cand SSO-ul nu raspunde. Fara aceste doua variabile, el nu exista.
ORAR_ADMIN_USER=
ORAR_ADMIN_PAROLA=
# Sau, in locul parolei in clar, hash-ul ei scrypt:
#   python -c "from orar.web.auth import hash_parola; print(hash_parola('parola'))"
# ORAR_ADMIN_PAROLA_HASH=

# 1 cand situl e servit prin HTTPS: cookie-urile devin `Secure`.
# ORAR_HTTPS=1
